[run]
source = src/app
omit = 
    */secrets_util.py
    */utils.py
    src/app/audit_logger.py
    */__init__.py
    */test_*.py
    */tests/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    
precision = 2
show_missing = True

[html]
directory = htmlcov

{
  "Comment": "State machine to process insights",
  "StartAt": "Validate Insight File",
  "States": {
    "Validate Insight File": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:${region}:${account}:function:${short_name}-${environment}-validate-insight-file",
        "Payload": {
          "execution_id.$": "$$.Execution.Id",
          "event.$": "$"
        }
      },
      "ResultPath": "$.validate_result",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "Failure"
        }
      ],
      "Next": "Category Data Exists?"
    },
    "Category Data Exists?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.validate_result.Payload.category_data",
          "BooleanEquals": false,
          "Next": "Process Insight File"
        },
        {
          "Variable": "$.validate_result.Payload.category_data",
          "BooleanEquals": true,
          "Next": "Save Insight Data To Database"
        }
      ]
    },
    "Process Insight File": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:${region}:${account}:function:${short_name}-${environment}-extend-insight-category",
        "Payload.$": "$"
      },
      "ResultPath": "$.processed_result",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 3,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "Failure"
        }
      ],
      "Next": "Save Insight Data To Database"
    },
    "Save Insight Data To Database": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:${region}:${account}:function:${short_name}-${environment}-save-insights-to-db",
        "Payload.$": "$"
      },
      "ResultPath": "$.saved_insights_to_db",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 3,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "Failure"
        }
      ],
      "Next": "Success"
    },
    "Success": {
      "Type": "Succeed"
    },
    "Failure": {
      "Type": "Fail"
    }
  }
}

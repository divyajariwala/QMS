              "Operational and Maintenance Procedures Issue",
              "Corrective Maintenance Issue",
              "Monitoring Issue"
            ]
          },
          "Procedure/Instruction Issue": {
            "description": "Problems with equipment-related procedures or instructions",
            "root_causes": [
